const express = require('express');
const session = require('express-session');
const cors = require('cors');
const axios = require('axios');
const bcrypt = require('bcryptjs');
const fs = require('fs');
const path = require('path');
const { v4: uuidv4 } = require('uuid');
require('dotenv').config();

const app = express();
const PORT = process.env.PORT || 5000;
const DATA_DIR = path.join(__dirname, 'data');
const DATA_FILE = path.join(DATA_DIR, 'db.json');

const HEALTH_DISCLAIMER = `
⚠️ IMPORTANT DISCLAIMER:
This AI tool provides general health information only and is not a substitute for professional medical advice.
For emergencies, call emergency services immediately. Always consult qualified healthcare professionals for diagnosis and treatment.
`;

app.use(cors({ origin: true, credentials: true }));
app.use(express.json({ limit: '1mb' }));
app.use(express.urlencoded({ extended: true }));
app.use(
  session({
    secret: process.env.SESSION_SECRET || 'ai-health-assistant-secret',
    resave: false,
    saveUninitialized: false,
    cookie: {
      httpOnly: true,
      sameSite: 'lax',
      secure: false,
      maxAge: 1000 * 60 * 60 * 24 * 7,
    },
  })
);

app.use(express.static(path.join(__dirname, 'public')));

function ensureDb() {
  fs.mkdirSync(DATA_DIR, { recursive: true });
  if (!fs.existsSync(DATA_FILE)) {
    const initialState = {
      users: [],
      appointments: [],
      healthRecords: [],
      chatHistory: {},
    };
    fs.writeFileSync(DATA_FILE, JSON.stringify(initialState, null, 2));
  }
}

function readDb() {
  ensureDb();
  try {
    return JSON.parse(fs.readFileSync(DATA_FILE, 'utf8'));
  } catch (error) {
    return {
      users: [],
      appointments: [],
      healthRecords: [],
      chatHistory: {},
    };
  }
}

function writeDb(data) {
  fs.writeFileSync(DATA_FILE, JSON.stringify(data, null, 2));
}

function sanitizeUser(user) {
  return {
    id: user.id,
    name: user.name,
    email: user.email,
    createdAt: user.createdAt,
  };
}

function getUserFromSession(req) {
  return req.session && req.session.user ? req.session.user : null;
}

function getLocalHealthResponse(message) {
  const text = message.toLowerCase();

  if (/(fever|temperature|hot)/.test(text)) {
    return `A fever often means your body is fighting an infection. Rest, stay hydrated, and monitor your temperature. If the fever is high, lasts more than 3 days, or if you have breathing trouble, chest pain, confusion, or are unable to keep fluids down, seek medical care promptly.\n\nGeneral care: drink fluids, rest, and use fever-reducing medication only as directed by a clinician or packaging instructions.`;
  }

  if (/(headache|migraine)/.test(text)) {
    return `Headaches can be caused by stress, dehydration, tension, sleep issues, or illness. Rest in a dark, quiet room, stay hydrated, and avoid triggers. Seek urgent medical evaluation if the headache is sudden and severe, you have neurological symptoms, fever with stiff neck, vomiting, or worsening pain.`;
  }

  if (/(cough|cold|sore throat)/.test(text)) {
    return `A cough or sore throat can be caused by viral illness, allergies, or irritation. Rest, warm fluids, saline gargles, and plenty of hydration may help. Seek advice from a healthcare professional if you have trouble breathing, high fever, chest pain, or symptoms lasting more than a week or worsening.`;
  }

  if (/(fatigue|tired|weak)/.test(text)) {
    return `Fatigue can result from poor sleep, stress, dehydration, illness, or overexertion. Aim for consistent sleep, regular meals, hydration, and moderate activity. If fatigue is severe, persistent, or accompanied by weight changes, fever, chest pain, or shortness of breath, talk to a doctor.`;
  }

  if (/(anxious|stress|panic|anxiety)/.test(text)) {
    return `Stress and anxiety can affect sleep, digestion, focus, and energy. Try deep breathing, regular breaks, journaling, exercise, and time outdoors. If your anxiety is intense, persistent, or interfering with daily life, connecting with a mental health professional can help.`;
  }

  return `Here are some general wellness steps: stay hydrated, prioritize sleep, eat balanced meals, move your body regularly, and monitor symptoms closely. If your symptoms are severe, worsening, or new, consult a healthcare provider promptly.\n\nIf you can, share more detail about your symptoms, duration, and severity so I can guide you more specifically.`;
}

async function getOpenAIResponse(message, history) {
  const apiKey = process.env.OPENAI_API_KEY;
  if (!apiKey) return getLocalHealthResponse(message);

  const systemPrompt = `You are a helpful AI health assistant. Provide general health information and wellness advice only. Never diagnose or replace a doctor. Always include a brief safety warning and ask clarifying questions when useful. For emergencies, recommend urgent emergency care.`;

  try {
    const response = await axios.post(
      'https://api.openai.com/v1/chat/completions',
      {
        model: 'gpt-3.5-turbo',
        messages: [
          { role: 'system', content: systemPrompt },
          ...history.map((entry) => ({ role: entry.role, content: entry.content })),
          { role: 'user', content: message },
        ],
        temperature: 0.7,
        max_tokens: 500,
      },
      {
        headers: {
          Authorization: `Bearer ${apiKey}`,
          'Content-Type': 'application/json',
        },
      }
    );

    return response.data.choices[0].message.content;
  } catch (error) {
    return getLocalHealthResponse(message);
  }
}

async function getGoogleAIResponse(message, history) {
  const apiKey = process.env.GOOGLE_API_KEY;
  if (!apiKey) return getLocalHealthResponse(message);

  const prompt = `You are a health assistant. Provide general wellness guidance. Never diagnose. Include a brief disclaimer and suggest a clinician for serious symptoms.\n\n${history
    .map((entry) => `${entry.role}: ${entry.content}`)
    .join('\n')}\nUser: ${message}`;

  try {
    const response = await axios.post(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent?key=${apiKey}`,
      {
        contents: [{ parts: [{ text: prompt }] }],
        generationConfig: {
          temperature: 0.7,
          maxOutputTokens: 500,
        },
      },
      {
        headers: {
          'Content-Type': 'application/json',
        },
      }
    );

    return response.data.candidates?.[0]?.content?.parts?.[0]?.text || getLocalHealthResponse(message);
  } catch (error) {
    return getLocalHealthResponse(message);
  }
}

app.get('/api/session', (req, res) => {
  const user = getUserFromSession(req);
  if (!user) {
    return res.json({ authenticated: false });
  }

  return res.json({ authenticated: true, user: sanitizeUser(user) });
});

app.post('/api/register', async (req, res) => {
  const { name, email, password } = req.body;

  if (!name || !email || !password) {
    return res.status(400).json({ message: 'Name, email, and password are required.' });
  }

  const db = readDb();
  const existingUser = db.users.find((user) => user.email.toLowerCase() === email.toLowerCase());

  if (existingUser) {
    return res.status(409).json({ message: 'A user with this email already exists.' });
  }

  const hashedPassword = await bcrypt.hash(password, 10);
  const user = {
    id: uuidv4(),
    name,
    email: email.toLowerCase(),
    password: hashedPassword,
    createdAt: new Date().toISOString(),
  };

  db.users.push(user);
  db.chatHistory[user.id] = [];
  writeDb(db);

  req.session.user = sanitizeUser(user);
  return res.status(201).json({
    message: 'User registered successfully.',
    user: sanitizeUser(user),
    disclaimer: HEALTH_DISCLAIMER,
  });
});

app.post('/api/login', async (req, res) => {
  const { email, password } = req.body;

  if (!email || !password) {
    return res.status(400).json({ message: 'Email and password are required.' });
  }

  const db = readDb();
  const user = db.users.find((item) => item.email.toLowerCase() === email.toLowerCase());

  if (!user) {
    return res.status(401).json({ message: 'Invalid email or password.' });
  }

  const isMatch = await bcrypt.compare(password, user.password);
  if (!isMatch) {
    return res.status(401).json({ message: 'Invalid email or password.' });
  }

  req.session.user = sanitizeUser(user);
  return res.json({
    message: 'Logged in successfully.',
    user: sanitizeUser(user),
    disclaimer: HEALTH_DISCLAIMER,
  });
});

app.post('/api/logout', (req, res) => {
  req.session.destroy(() => {
    res.json({ message: 'Logged out successfully.' });
  });
});

app.get('/api/health-tips', (req, res) => {
  const tips = [
    { category: 'Hydration', tip: 'Drink enough water to stay hydrated throughout the day.' },
    { category: 'Exercise', tip: 'Aim for at least 30 minutes of light movement most days.' },
    { category: 'Sleep', tip: 'Maintain a consistent bedtime and reduce screen exposure before sleep.' },
    { category: 'Nutrition', tip: 'Include fruits, vegetables, and whole grains in your meals.' },
    { category: 'Stress', tip: 'Try breathing exercises or short meditation breaks during busy days.' },
    { category: 'Mental Health', tip: 'Talk to someone you trust when stress or mood feels overwhelming.' },
  ];

  return res.json(tips);
});

app.get('/api/symptoms', (req, res) => {
  const symptoms = ['Fever', 'Headache', 'Cough', 'Fatigue', 'Sore Throat', 'Nausea', 'Dizziness', 'Body Ache', 'Sleep Issues'];
  return res.json(symptoms);
});

app.post('/api/chat', async (req, res) => {
  const user = getUserFromSession(req);
  if (!user) {
    return res.status(401).json({ message: 'Authentication required.' });
  }

  const { message, provider = 'openai' } = req.body;
  if (!message || !message.trim()) {
    return res.status(400).json({ message: 'Message is required.' });
  }

  const db = readDb();
  if (!db.chatHistory[user.id]) db.chatHistory[user.id] = [];

  db.chatHistory[user.id].push({ role: 'user', content: message.trim() });

  let aiResponse;
  const history = db.chatHistory[user.id];

  if (provider === 'google') {
    aiResponse = await getGoogleAIResponse(message.trim(), history);
  } else {
    aiResponse = await getOpenAIResponse(message.trim(), history);
  }

  db.chatHistory[user.id].push({ role: 'assistant', content: aiResponse });
  writeDb(db);

  return res.json({
    response: aiResponse,
    disclaimer: HEALTH_DISCLAIMER,
    user: sanitizeUser(user),
  });
});

app.get('/api/chat-history', (req, res) => {
  const user = getUserFromSession(req);
  if (!user) {
    return res.status(401).json({ message: 'Authentication required.' });
  }

  const db = readDb();
  const history = db.chatHistory[user.id] || [];
  return res.json(history);
});

app.post('/api/bmi', (req, res) => {
  const user = getUserFromSession(req);
  if (!user) {
    return res.status(401).json({ message: 'Authentication required.' });
  }

  const { heightCm, weightKg } = req.body;
  if (!heightCm || !weightKg) {
    return res.status(400).json({ message: 'Height and weight are required.' });
  }

  const heightInMeters = Number(heightCm) / 100;
  const bmi = Number(weightKg) / (heightInMeters * heightInMeters);

  let category = 'Normal';
  if (bmi < 18.5) category = 'Underweight';
  else if (bmi < 25) category = 'Normal';
  else if (bmi < 30) category = 'Overweight';
  else category = 'Obesity';

  const result = {
    bmi: bmi.toFixed(1),
    category,
    recommendation: category === 'Normal'
      ? 'Your BMI is in a healthy range. Continue regular sleep, exercise, and balanced nutrition.'
      : category === 'Underweight'
        ? 'Consider increasing nutrient-dense foods and consulting a clinician if weight loss is unintended.'
        : category === 'Overweight'
          ? 'Regular exercise and a balanced diet can help improve your health markers.'
          : 'It may help to work with a healthcare professional on a sustainable wellness plan.',
  };

  return res.json(result);
});

app.post('/api/health-records', (req, res) => {
  const user = getUserFromSession(req);
  if (!user) {
    return res.status(401).json({ message: 'Authentication required.' });
  }

  const { date, bloodPressure, heartRate, sleepHours, hydration, notes } = req.body;
  const db = readDb();
  const entry = {
    id: uuidv4(),
    userId: user.id,
    date: date || new Date().toISOString().slice(0, 10),
    bloodPressure: bloodPressure || '',
    heartRate: heartRate || '',
    sleepHours: sleepHours || '',
    hydration: hydration || '',
    notes: notes || '',
    createdAt: new Date().toISOString(),
  };

  db.healthRecords.push(entry);
  writeDb(db);
  return res.status(201).json({ message: 'Health record saved.', record: entry });
});

app.get('/api/health-records', (req, res) => {
  const user = getUserFromSession(req);
  if (!user) {
    return res.status(401).json({ message: 'Authentication required.' });
  }

  const db = readDb();
  const records = db.healthRecords.filter((record) => record.userId === user.id);
  return res.json(records.slice().reverse());
});

app.post('/api/appointments', (req, res) => {
  const user = getUserFromSession(req);
  if (!user) {
    return res.status(401).json({ message: 'Authentication required.' });
  }

  const { doctorName, specialty, appointmentDate, appointmentTime, reason } = req.body;
  if (!doctorName || !specialty || !appointmentDate || !appointmentTime || !reason) {
    return res.status(400).json({ message: 'Please fill in all appointment details.' });
  }

  const db = readDb();
  const appointment = {
    id: uuidv4(),
    userId: user.id,
    doctorName,
    specialty,
    appointmentDate,
    appointmentTime,
    reason,
    status: 'Scheduled',
    createdAt: new Date().toISOString(),
  };

  db.appointments.push(appointment);
  writeDb(db);
  return res.status(201).json({ message: 'Appointment scheduled.', appointment });
});

app.get('/api/appointments', (req, res) => {
  const user = getUserFromSession(req);
  if (!user) {
    return res.status(401).json({ message: 'Authentication required.' });
  }

  const db = readDb();
  const appointments = db.appointments.filter((item) => item.userId === user.id);
  return res.json(appointments.slice().reverse());
});

app.get('/api/default-health-checkup', (req, res) => {
  const checklist = [
    'Check blood pressure and heart rate regularly',
    'Track your sleep quality and hydration',
    'Schedule annual checkups and vaccinations',
    'Discuss any persistent symptoms with a doctor',
  ];
  return res.json(checklist);
});

app.get('*', (req, res) => {
  res.sendFile(path.join(__dirname, 'public', 'index.html'));
});

app.listen(PORT, () => {
  console.log(`🏥 AI Health Assistant is running at http://localhost:${PORT}`);
});
